# Local runtimes, downloaded caches and reproducible builds.
.venv/
venv/
__pycache__/
*.py[cod]
node_modules/
.deps/
.models/
.cache/
.pytest_cache/
.codegraph/
build/
dist/

# Credentials and machine-local settings are never published.
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
credentials.json
token.json

# Partial downloads, temporary files and local Git safety snapshots.
*.download
*.tmp
*.log
backups/git/
coordination/.state.lock

# Project source, examples, artwork, QC and rendered deliverables are included.
# Large audio/video/archive/model files use Git LFS (see .gitattributes).
