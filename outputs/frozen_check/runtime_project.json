  "subtitles": [
    {
      "id": "e26e20231dd0",
      "start": 0,
      "end": 5,
      "text": "Ngày còn nhỏ, tôi luôn đi dưới chiếc ô vàng của cha.",
      "role": "Narrator"
    },
    {
      "id": "cf4bf9bc446e",
      "start": 5,
      "end": 10,
      "text": "Mưa rơi trên con đường quen thuộc, cha bước chậm theo tôi.",
      "role": "Narrator"
    },
    {
      "id": "964bd33081d6",
      "start": 10,
      "end": 15,
      "text": "Chiếc ô nghiêng về phía con, còn vai cha thì ướt.",
      "role": "Narrator"
    },
    {
      "id": "7171ade460e0",
      "start": 15,
      "end": 20,
      "text": "Tôi thích nhảy qua những vũng nước sau cơn mưa.",
      "role": "Narrator"
    },
    {
      "id": "d3af769a4c5d",
      "start": 20,
      "end": 25,
      "text": "Cha đưa tay giữ lấy tôi trước mỗi bước nhảy.",
      "role": "Narrator"
    },
    {
      "id": "dcd6f79c690a",
      "start": 25,
      "end": 30,
      "text": "Khi ấy, tôi chỉ biết cười, chưa hiểu sự chở che.",
      "role": "Narrator"
    },
    {
      "id": "e9170db63035",
      "start": 30,
      "end": 35,
      "text": "Mẹ đứng chờ hai cha con trước cánh cửa nhỏ.",
      "role": "Narrator"
    },
    {
      "id": "551934a1b461",
      "start": 35,
      "end": 40,
      "text": "Mẹ lau những giọt nước trên vai áo của cha.",
      "role": "Narrator"
    },
    {
      "id": "d425f8ccbba1",
      "start": 40,
      "end": 45,
      "text": "Cha cười và nói rằng con không bị ướt là được.",
      "role": "Narrator"
    },
    {
      "id": "12aa28a8037e",
      "start": 45,
      "end": 50,
      "text": "Thời gian trôi qua, đôi chân tôi dài thêm từng ngày.",
      "role": "Narrator"
    },
    {
      "id": "c87dd56d183b",
      "start": 50,
      "end": 55,
      "text": "Những bước chân nhỏ dần trở thành bước chân vội vã.",
      "role": "Narrator"
    },
    {
      "id": "f885eb39defa",
      "start": 55,
      "end": 60,
      "text": "Chiếc ô vàng vẫn ở đó, bình lặng cạnh cửa nhà.",
      "role": "Narrator"
    },
    {
      "id": "74447d632165",
      "start": 60,
      "end": 65,
      "text": "Lên tuổi thiếu niên, tôi muốn tự đi con đường của mình.",
      "role": "Narrator"
    },
    {
      "id": "94445273b79f",
      "start": 65,
      "end": 70,
      "text": "Tôi lắc đầu khi cha mang ô đến đón.",
      "role": "Narrator"
    },
    {
      "id": "cfc3830bd04a",
      "start": 70,
      "end": 75,
      "text": "Cha hạ bàn tay xuống, rồi lặng lẽ nhìn theo.",
      "role": "Narrator"
    },
    {
      "id": "2efdf98daf3d",
      "start": 75,
      "end": 80,
      "text": "Chiều hôm ấy, cha đứng một mình giữa tiếng mưa.",
      "role": "Narrator"
    },
    {
      "id": "a367567a0920",
      "start": 80,
      "end": 85,
      "text": "Chiếc ô vàng không còn một đứa trẻ đi bên cạnh.",
      "role": "Narrator"
    },
    {
      "id": "76a46afab468",
      "start": 85,
      "end": 90,
      "text": "Nhưng cha vẫn giữ thói quen nghiêng ô về phía ấy.",
      "role": "Narrator"
    },
    {
      "id": "29df04ee49af",
      "start": 90,
      "end": 95,
      "text": "Lớn lên, tôi sống xa nhà, bận rộn với những cuộc hẹn.",
      "role": "Narrator"
    },
    {
      "id": "bab74a15ca04",
      "start": 95,
      "end": 100,
      "text": "Điện thoại reo. Cha hỏi tôi có mang ô theo không.",
      "role": "Narrator"
    },
    {
      "id": "81bfc0df45d0",
      "start": 100,
      "end": 105,
      "text": "Tôi đáp vội rằng mình ổn, rồi im lặng thật lâu.",
      "role": "Narrator"
    },
    {
      "id": "4016e913395a",
      "start": 105,
      "end": 110,
      "text": "Mẹ gửi cho tôi một bức hình chiếc ô cũ.",
      "role": "Narrator"
    },
    {
      "id": "9678e2b1abe3",
      "start": 110,
      "end": 115,
      "text": "Cha vừa sửa lại nan ô, dù màu vàng đã bạc.",
      "role": "Narrator"
    },
    {
      "id": "49cc86343106",
      "start": 115,
      "end": 120,
      "text": "Có những điều được giữ lại chỉ vì một người thương.",
      "role": "Narrator"
    },
    {
      "id": "ff57ef5fddd3",
      "start": 120,
      "end": 125,
      "text": "Tôi gấp công việc lại và đặt vé trở về nhà.",
      "role": "Narrator"
    },
    {
      "id": "f50546c37fa6",
      "start": 125,
      "end": 130,
      "text": "Trong chiếc túi nhỏ, tôi mang theo lời chưa kịp nói.",
      "role": "Narrator"
    },
    {
      "id": "7fd42d6d625c",
      "start": 130,
      "end": 135,
      "text": "Con đường cũ hiện ra, cùng một buổi chiều có mưa.",
      "role": "Narrator"
    },
    {
      "id": "f2e31cfd3730",
      "start": 135,
      "end": 140,
      "text": "Cha đã già, đứng trước cổng và nhìn ra đầu ngõ.",
      "role": "Narrator"
    },
    {
      "id": "22e673d1fe81",
      "start": 140,
      "end": 145,
      "text": "Bàn tay cầm ô run nhẹ, mái tóc đã bạc nhiều.",
      "role": "Narrator"
    },
    {
      "id": "b73d0a381ab0",
      "start": 145,
      "end": 150,
      "text": "Tôi bước đến gần cha, chậm như cha từng bước.",
      "role": "Narrator"
    },
    {
      "id": "54e372950740",
      "start": 150,
      "end": 155,
      "text": "Cha đưa chiếc ô sang. Lần này, tôi nhận lấy.",
      "role": "Narrator"
    },
    {
      "id": "6c4bf17c981e",
      "start": 155,
      "end": 160,
      "text": "Tôi nâng ô lên và nghiêng về phía cha.",
      "role": "Narrator"
    },
    {
      "id": "d1bd41bd76b3",
      "start": 160,
      "end": 165,
      "text": "Mưa chạm vào vai tôi. Cha nhìn tôi và mỉm cười.",
      "role": "Narrator"
    },
    {
      "id": "2c0f69e6dfa8",
      "start": 165,
      "end": 170,
      "text": "Mẹ vẫn đứng chờ trước cánh cửa ngày xưa.",
      "role": "Narrator"
    },
    {
      "id": "a3b2bc3a1fdd",
      "start": 170,
      "end": 175,
      "text": "Ba người cùng bước vào nhà, trong một vòng tay ấm.",
      "role": "Narrator"
    },
    {
      "id": "befc52aef9fe",
      "start": 175,
      "end": 180,
      "text": "Chiếc ô vẫn nghiêng. Chỉ có người cầm ô đã đổi.",
      "role": "Narrator"
    }
  ],
