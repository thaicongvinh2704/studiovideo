    },
    {
      "id": 46,
      "text": "Bởi nếu kể rằng toàn bộ dân cư bị giết, hoặc cả thành phố biến mất chỉ trong một đêm, chúng ta sẽ làm câu chuyện dữ dội hơn bằng những điều chưa được chứng minh.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_046.wav"
    },
    {
      "id": 47,
      "text": "Điều có thể nói là cuộc tấn công đã gây tác động nặng nề lên cộng đồng sống tại đây.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_047.wav"
    },
    {
      "id": 48,
      "text": "Đằng sau một dòng ghi chiến công là sự đứt gãy mà dữ liệu về cư trú và sử dụng đất vẫn còn cho thấy.",
      "seed": 284617,
