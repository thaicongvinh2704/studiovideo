    },
    {
      "id": 43,
      "text": "Bao nhiêu người chết? Bao nhiêu người bị bắt? Bao nhiêu người đã bỏ chạy?",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_043.wav"
    },
    {
