      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_013.wav"
    },
    {
      "id": 14,
      "text": "Một trận cháy lớn chưa đủ để kết luận có quân đội tấn công.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_014.wav"
    },
    {
