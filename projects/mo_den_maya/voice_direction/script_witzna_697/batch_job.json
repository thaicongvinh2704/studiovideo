  "units": [
    {
      "id": 1,
      "text": "Người chiến thắng đã khắc lên đá ngày họ đốt một thành phố.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_001.wav"
    },
    {
      "id": 2,
      "text": "Hơn một nghìn ba trăm năm sau, các nhà nghiên cứu tìm thấy dấu vết của cuộc tấn công ấy dưới đáy hồ.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_002.wav"
    },
    {
      "id": 3,
      "text": "Nhưng ban đầu, họ không đi tìm chiến tranh. Họ đang tìm hiểu khí hậu.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_003.wav"
    },
    {
      "id": 4,
      "text": "Câu chuyện bắt đầu ở miền bắc Gua-te-ma-la, gần tàn tích một thành phố Maya ngày nay được gọi là Vít-na.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_004.wav"
    },
    {
      "id": 5,
      "text": "Năm hai nghìn không trăm mười ba, nhóm nghiên cứu lấy những mẫu trầm tích từ hồ La-gu-na Éc Náp.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_005.wav"
    },
    {
      "id": 6,
      "text": "Qua thời gian, vật chất lắng xuống đáy hồ thành từng lớp.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_006.wav"
    },
    {
      "id": 7,
      "text": "Trong đó có phấn hoa, những dấu hiệu hóa học và các mảnh than.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_007.wav"
    },
    {
      "id": 8,
      "text": "Chúng giúp người nghiên cứu lần ngược về cảnh quan trước đây: cây gì từng mọc, đất đai được sử dụng ra sao, khi nào có lửa.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_008.wav"
    },
    {
      "id": 9,
      "text": "Rồi họ gặp một lớp than nổi bật.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_009.wav"
    },
    {
      "id": 10,
      "text": "Nó cho thấy một trận cháy lớn đã xảy ra quanh cuối thế kỷ thứ bảy.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_010.wav"
    },
    {
      "id": 11,
      "text": "Sau sự kiện ấy, các dấu hiệu về hoạt động của con người giảm mạnh.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_011.wav"
    },
    {
      "id": 12,
      "text": "Một nơi từng có người sinh sống và canh tác đã thay đổi rõ rệt sau đám cháy.",
      "seed": 284617,
      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_012.wav"
    },
    {
      "id": 13,
      "text": "Chuyện gì đã xảy ra ở đó?",
