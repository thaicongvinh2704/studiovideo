      "output": "D:\\stickman-animation-studio\\stickman-animation-studio\\projects\\mo_den_maya\\voice_direction\\script_witzna_697\\raw\\unit_026.wav"
    },
    {
      "id": 27,
      "text": "Sức nặng của phát hiện nằm ở việc hai nguồn bằng chứng khác nhau phù hợp với nhau.",
