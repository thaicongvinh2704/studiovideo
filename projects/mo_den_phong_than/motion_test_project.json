  "subtitles": [
    {
      "id": "sub_c68",
      "start": 0.23,
      "end": 5.09,
      "text": "Khi được gọi lên, ông vẫn giữ khí thế cũ, dẫn theo các vị thuộc Lôi bộ tiến đến mà chưa chịu quỳ."
    },
    {
      "id": "sub_c69",
      "start": 5.17,
      "end": 8.88,
      "text": "Khương Tử Nha phải cầm roi, yêu cầu ông quỳ nghe sắc lệnh, ông mới làm theo."
    },
    {
      "id": "sub_c70",
      "start": 9.18,
      "end": 14.04,
      "text": "Người từng chống Tử Nha đến cùng nay được giao đứng đầu Lôi bộ, nhận chức Cửu Thiên Ứng Nguyên Lôi Thanh Phổ Hóa Thiên Tôn."
    },
    {
      "id": "sub_c71",
      "start": 14.16,
      "end": 21.27,
      "text": "Sắc phong nhắc đến sự tận trung của ông với hai đời vua. Chức trách mới liên quan đến mây mưa, nuôi dưỡng vạn vật, trừ gian và việc họa phúc theo thiện ác."
    }
  ],
