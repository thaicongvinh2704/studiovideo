      "start": 0.0,
      "end": 2.028,
      "text": "Khương Tử Nha vừa ra lệnh xử chém hai người.",
      "role": "Narrator"
    },
    {
      "id": "92c4ce3a24e0",
      "start": 2.22,
      "end": 6.572,
      "text": "Tội của họ được kể rất rõ: làm loạn triều chính, mê hoặc nhà vua, khiến đất nước sụp đổ.",
      "role": "Narrator"
    },
    {
      "id": "0a3906a9e085",
      "start": 6.636,
      "end": 10.348,
      "text": "Đến khi chủ cũ chết, họ lại đem của báu sang cầu được làm quan cho triều đại mới.",
      "role": "Narrator"
    }
  ],
